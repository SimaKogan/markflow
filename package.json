{
  "name": "markflow",
  "productName": "Markflow",
  "version": "1.0.0",
  "description": "A fast, beautiful Markdown editor with live preview, KaTeX and syntax highlighting.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "vite",
    "codemirror",
    "katex"
  ],
  "author": "Serafima Kogan <serafima.kogan@gmail.com> (https://github.com/SimaKogan)",
  "license": "MIT",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/language-data": "^6.5.1",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "marked": "^14.1.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.simakogan.markflow",
    "productName": "Markflow",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
